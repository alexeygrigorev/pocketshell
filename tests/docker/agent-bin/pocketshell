#!/bin/sh
set -eu

# Deterministic fixture for the unified `pocketshell` CLI.
#
# Issue #231 swapped the Android app from the legacy `quse` / `tmuxctl`
# probes to the unified `pocketshell usage|sessions|jobs ...` CLI (D22
# hard-cut). On a real host `pocketshell` is a thin wrapper that proxies
# its output byte-for-byte from the underlying `quse` / `tmuxctl`
# binaries (see tools/pocketshell/src/pocketshell/{usage,sessions,jobs}.py),
# so this fixture reuses the same canned payloads the app's parsers were
# written against:
#   - `pocketshell usage --json`            -> PocketshellUsageJsonParser
#   - `pocketshell sessions list [--by ..]` -> HostTmuxSessionListParser
#   - `pocketshell jobs list [--session N]` -> RecurringJobsParser
#   - `pocketshell agent-log --json ...`    -> AgentConversationRepository

fixture_dir="${POCKETSHELL_AGENT_FIXTURE_DIR:-/opt/pocketshell-agent-fixtures}"
version_file="${POCKETSHELL_AGENT_FIXTURE_VERSION_FILE:-/opt/pocketshell-agent-fixture-version}"

fixture_version() {
  if [ -n "${POCKETSHELL_AGENT_FIXTURE_VERSION:-}" ]; then
    printf '%s\n' "$POCKETSHELL_AGENT_FIXTURE_VERSION"
    return 0
  fi
  if [ -r "$version_file" ]; then
    cat "$version_file"
    return 0
  fi
  # Issue #2356 (Phase 4 of epic #2350): app/build.gradle.kts's versionName
  # is no longer a literal to sed out of the DSL text -- it is derived from
  # the git tag via scripts/derive-version.sh (the same script
  # app/build.gradle.kts itself shells out to). Delegate to it instead of a
  # second, independently-written derivation.
  derive_script="${POCKETSHELL_PROJECT_ROOT:-.}/scripts/derive-version.sh"
  if [ -r "$derive_script" ]; then
    parsed_version="$(bash "$derive_script" version-name 2>/dev/null || true)"
    if [ -n "$parsed_version" ]; then
      printf '%s\n' "$parsed_version"
      return 0
    fi
  fi
  printf '0.0.0\n'
}

json_escape_awk='
function esc(s) {
  gsub(/\\/, "\\\\", s)
  gsub(/"/, "\\\"", s)
  return s
}
{
  lines[++count] = $0
}
END {
  printf "{\"count\":%d,\"engine\":\"%s\",\"lines\":[", count, engine
  for (i = 1; i <= count; i++) {
    if (i > 1) printf ","
    printf "\"%s\"", esc(lines[i])
  }
  printf "],\"path\":\"%s\",\"session\":\"%s\"}\n", esc(path), esc(session)
}
'

case "${1:-}" in
  --version)
    printf 'pocketshell fixture %s\n' "$(fixture_version)"
    exit 0
    ;;
  send)
    # Issue #2122/#2124: the ACKNOWLEDGED delivery primitive. This fixture
    # mirrors the real CLI's observable contract — durable token journal,
    # binary-safe stdin payload, `load-buffer`/`paste-buffer -d -r`, optional
    # `send-keys Enter`, and the STABLE exit codes the client branches on:
    #
    #   0 delivered | already-delivered   2 bad-usage
    #   3 pane-not-found                  4 tmux-failed
    #   5 send-interrupted               6 timeout
    #   7 journal-failed                 8 send-in-progress
    #
    # Issue #2240 closes the old fixture gap: use the repository's real host
    # implementation for this verb. The deterministic wrapper still owns every
    # other probe below, while this arm exercises the actual two-phase journal,
    # owner liveness, and --resend-interrupted contract on the Docker wire.
    exec /usr/local/bin/pocketshell-real-send "$@"
    shift
    send_pane=""
    send_token=""
    send_enter=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --pane) send_pane="${2:-}"; shift 2 || true ;;
        --token) send_token="${2:-}"; shift 2 || true ;;
        --enter) send_enter=1; shift ;;
        --timeout) shift 2 || true ;;
        --socket-name) shift 2 || true ;;
        --resend-interrupted) shift ;;
        *) shift ;;
      esac
    done
    # ALWAYS read the payload first, even on the short-circuit paths: exiting
    # without draining stdin gives the writer SIGPIPE, so a successful ack
    # surfaces to the caller as a failed write (real CLI, #2122 finding F3).
    send_payload_file="$(mktemp)"
    cat > "$send_payload_file" || true
    if [ -z "$send_pane" ] || [ -z "$send_token" ]; then
      rm -f "$send_payload_file"
      printf 'bad-usage\n'
      printf -- '--pane and --token are required\n' >&2
      exit 2
    fi
    send_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/pocketshell/sends"
    mkdir -p "$send_state_dir"
    send_hash="$(printf %s "$send_token" | sha256sum | cut -d' ' -f1)"
    send_record="$send_state_dir/$send_hash.json"
    if [ -f "$send_record" ]; then
      rm -f "$send_payload_file"
      printf 'already-delivered %s\n' "$(cat "$send_record")"
      exit 0
    fi
    # An EXACT pane-id match against the server's live list. `display-message
    # -t` is NOT a usable existence check here: tmux 3.6b resolves an unknown
    # `%999` to the current pane and exits 0, so the fixture would report
    # `tmux-failed` for a missing pane instead of the documented
    # `pane-not-found` (verified in-container while building this fixture).
    if ! tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx -- "$send_pane"; then
      rm -f "$send_payload_file"
      printf 'pane-not-found\n'
      printf 'no such pane: %s\n' "$send_pane" >&2
      exit 3
    fi
    send_buffer="pssend$(printf %s "$send_hash" | cut -c1-16)"
    if ! tmux load-buffer -b "$send_buffer" "$send_payload_file" 2>/dev/null; then
      rm -f "$send_payload_file"
      printf 'tmux-failed\n'
      printf 'load-buffer failed\n' >&2
      exit 4
    fi
    rm -f "$send_payload_file"
    # `-r` is load-bearing: without it tmux rewrites every \n into \r, which an
    # agent input box reads as SUBMIT and tears a multi-line prompt into one
    # prompt per line (issue #1636).
    if ! tmux paste-buffer -d -r -b "$send_buffer" -t "$send_pane" 2>/dev/null; then
      printf 'tmux-failed\n'
      printf 'paste-buffer failed\n' >&2
      exit 4
    fi
    if [ "$send_enter" = "1" ]; then
      tmux send-keys -t "$send_pane" Enter 2>/dev/null || true
    fi
    # Journal AFTER the injection succeeded — never record a delivery that did
    # not happen. Written temp-then-rename so a killed process cannot leave a
    # half-written entry.
    printf '{"schema":1,"token":"%s","state":"delivered","at":%s}\n' \
      "$send_token" "$(date +%s)" > "$send_record.tmp"
    mv "$send_record.tmp" "$send_record"
    printf 'delivered\n'
    exit 0
    ;;
  agent)
    # Issue #703: the app now launches agents via the short server-side
    # wrapper `pocketshell agent <kind> --dir <dir> [--no-skip-permissions]
    # [--config-dir <dir>]` instead of a giant inline env-strip line. This
    # fixture mirrors the real wrapper's observable behaviour: parse the
    # short argv, cd into --dir, then exec the (fake) agent so the
    # AgentLaunchCommandDockerTest sees the agent's ready output land in the
    # pane — proving the wrapper exec'd the agent, not just that text was
    # typed. The real wrapper additionally merges .env/.envrc, strips the
    # provider env for opencode, and suppresses first-run prompts; the fake
    # agents have no such prompts so nothing extra is needed here.
    shift
    agent_kind="${1:-}"
    shift || true
    agent_dir=""
    agent_profile=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --dir)
          agent_dir="${2:-}"
          shift 2
          ;;
        --skip-permissions|--no-skip-permissions)
          shift
          ;;
        --config-dir)
          shift 2
          ;;
        --profile)
          agent_profile="${2:-}"
          shift 2
          ;;
        *)
          shift
          ;;
      esac
    done
    if [ -n "$agent_dir" ]; then
      cd "$agent_dir" 2>/dev/null || true
    fi
    # Issue #821 / #858 / #889: mirror the REAL wrapper's record_agent_kind
    # (tools/pocketshell/src/pocketshell/agents.py) so an end-to-end Docker
    # journey exercises the SAME tmux user-option write/clear the device hits,
    # not a happy fake that never records. Inside tmux ($TMUX set, e.g. a
    # send-keys-launched pane) the kind is ALWAYS written, and the profile is
    # RECONCILED to this launch: a non-default --profile sets the label, a
    # default / no-profile launch UNSETS the option (`set-option -uq`) so a
    # stale z.ai @ps_agent_profile cannot survive a default relaunch in the same
    # tmux session (the #889 reported false-label root cause). Best-effort: a
    # tmux failure never blocks the agent launch.
    if [ -n "${TMUX:-}" ] && [ -n "$agent_kind" ]; then
      tmux set-option @ps_agent_kind "$agent_kind" 2>/dev/null || true
      if [ -n "$agent_profile" ]; then
        tmux set-option @ps_agent_profile "$agent_profile" 2>/dev/null || true
      else
        tmux set-option -uq @ps_agent_profile 2>/dev/null || true
      fi
    fi
    case "$agent_kind" in
      codex|claude|opencode)
        exec "$agent_kind"
        ;;
      *)
        printf 'pocketshell agent fixture supports: codex|claude|opencode\n' >&2
        exit 64
        ;;
    esac
    ;;
  agents)
    # Epic #821 A2-infra (issue #827): the unified CLI grew `pocketshell
    # agents kind`, the seam over the `agents.kind_for_panes` daemon RPC. The
    # client pipes a pane list as `{"panes":[{"pane_id","pane_pid"}, ...]}` JSON
    # on stdin (and/or `--pane PANE_ID=PANE_PID`) and parses back
    # `{"results":[{"pane_id","agent_kind","scope","evidence_pid"?}]}`.
    #
    # This Docker container has no real cgroup-v2 scope tree, so the fixture
    # can't run the live classifier. Instead it answers DETERMINISTICALLY for
    # SYNTHETIC (non-existent) pane pids, so a connected test can assert a
    # foreign session's guessed kind without seeding a cgroup tree:
    #   pid 1000-1999 -> claude (scope tmuxctl-claude-main.scope)
    #   pid 2000-2999 -> codex  (scope tmuxctl-codex.scope)
    #   pid 3000-3999 -> opencode (scope tmuxctl-opencode-lab.scope)
    #   pid 4000-4999 -> none   (scope tmuxctl-shell.scope; readable, no agent)
    #   missing / non-integer / any other pid -> unknown (scope null)
    # These ranges line up with the seeded fixture sessions claude-main / codex
    # / opencode-lab (see pocketshell-sessions-list.txt) so the guess matches
    # the synthetic session the test joins.
    #
    # Issue #1973: a REAL live tmux pane pid must never enter this synthetic
    # table. The nightly suite advances the container PID allocator through
    # these ranges; the old fixture then called an ordinary `sh` pane Claude /
    # Codex / OpenCode solely from its numeric pid. That contaminated later
    # state-readback and folder-list tests even though raw @ps_agent_kind was
    # absent, the previous agent sessions were gone, and /proc showed the pane
    # was a live shell in the container's root cgroup. A real pid is therefore
    # owned by the live fixture, not by the synthetic canned table: resolve it
    # to `none`. PocketShell-launched fixture agents remain covered by their
    # authoritative recorded @ps_agent_kind and never take this foreign path.
    #
    # Issue #975: one connected regression deliberately models the narrower
    # real-host failure where a LIVE pane is unreadable to the classifier while
    # its transcript is still trustworthy evidence. The seeder opts that exact
    # pid into `unknown` by creating
    # `/tmp/pocketshell-agents-kind-unknown-pids/<pid>`.  This is explicit
    # per-pane state, never pid-range inference, so the #1973 live-shell rule
    # remains authoritative for every unmarked live process.
    shift
    if [ "${1:-}" != "kind" ]; then
      printf 'pocketshell agents fixture supports: kind\n' >&2
      exit 64
    fi
    shift

    # Issue #1641: connected latency-fixture hook for the storm-entry-edge
    # journey. A foreign-pane kind-classify runs over the SHARED per-host `-CC`
    # lease transport under a fixed 3.5s bound (AgentKindRemoteSource /
    # BoundedSessionExec). Before the fix, a classify SLOWER than that bound
    # `close()`d the shared transport — killing the live `-CC` reader and
    # entering the #1610 reconnect storm. A localhost-fast classify can never
    # exceed 3.5s, so it proves NOTHING about that edge (the v0.4.10/#847
    # happy-fixture-masks-reality lesson, G10). This hook makes ONLY `agents
    # kind` genuinely slow — an alive-but-slow host CLI, exactly the reported
    # non-happy state — for the duration a connected test needs it.
    #
    # A test writes an integer number of seconds into the delay file over the
    # SAME warm SSH session; the classify then sleeps that long BEFORE it
    # answers (still returning a valid envelope, so the host is proven ALIVE,
    # not failing). No file / empty / non-integer => zero delay, so every other
    # `agents kind` consumer (the deterministic guess fixtures) is unaffected.
    delay_file="${POCKETSHELL_AGENTS_KIND_DELAY_FILE:-/tmp/pocketshell-agents-kind-delay-secs}"
    if [ -r "$delay_file" ]; then
      delay_secs="$(cat "$delay_file" 2>/dev/null || printf '')"
      case "$delay_secs" in
        '' | *[!0-9]*) : ;;
        *) sleep "$delay_secs" ;;
      esac
    fi

    # Collect panes from --pane PANE_ID=PANE_PID options.
    pane_specs=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --pane)
          pane_specs="${pane_specs}${2:-}
"
          shift 2
          ;;
        --proc-root|--cgroup-mount)
          shift 2
          ;;
        *)
          shift
          ;;
      esac
    done

    # Read stdin JSON panes when stdin is not a terminal. Extract pane_id /
    # pane_pid pairs without a JSON parser (busybox has no jq): pull every
    # "pane_id":... and "pane_pid":... token in document order. pane_pid is
    # numeric in the RPC shape; a missing pid yields an empty field -> unknown.
    if [ ! -t 0 ]; then
      stdin_json="$(cat)"
    else
      stdin_json=""
    fi

    printf '%s' "$stdin_json" | tr ',' '\n' | awk -v specs="$pane_specs" '
      function classify(pid,   n) {
        if (pid !~ /^[0-9]+$/) return "unknown\tnull"
        n = pid + 0
        if (system("test -f /tmp/pocketshell-agents-kind-unknown-pids/" n) == 0) return "unknown\tnull"
        if (system("test -d /proc/" n) == 0) return "none\tpocketshell-fixture-live.scope"
        if (n >= 1000 && n < 2000) return "claude\ttmuxctl-claude-main.scope"
        if (n >= 2000 && n < 3000) return "codex\ttmuxctl-codex.scope"
        if (n >= 3000 && n < 4000) return "opencode\ttmuxctl-opencode-lab.scope"
        if (n >= 4000 && n < 5000) return "none\ttmuxctl-shell.scope"
        return "unknown\tnull"
      }
      function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
      function emit(pid, pane_id,   c, kind, scope, parts) {
        c = classify(pid)
        split(c, parts, "\t")
        kind = parts[1]; scope = parts[2]
        if (n++ > 0) printf ","
        if (scope == "null") sval = "null"; else sval = "\"" esc(scope) "\""
        printf "{\"pane_id\":\"%s\",\"agent_kind\":\"%s\",\"scope\":%s}", esc(pane_id), kind, sval
      }
      BEGIN {
        printf "{\"results\":["
        # --pane PANE_ID=PANE_PID specs first.
        m = split(specs, lines, "\n")
        for (i = 1; i <= m; i++) {
          if (lines[i] == "") continue
          eq = index(lines[i], "=")
          if (eq == 0) continue
          pid_id = substr(lines[i], 1, eq - 1)
          pid_pid = substr(lines[i], eq + 1)
          emit(pid_pid, pid_id)
        }
      }
      # stdin JSON tokens, one comma-split fragment per line.
      /"pane_id"/ {
        if (match($0, /"pane_id"[ \t]*:[ \t]*"[^"]*"/)) {
          s = substr($0, RSTART, RLENGTH)
          sub(/^"pane_id"[ \t]*:[ \t]*"/, "", s); sub(/"$/, "", s)
          pending_id = s; have_id = 1
        }
      }
      /"pane_pid"/ {
        if (match($0, /"pane_pid"[ \t]*:[ \t]*[0-9]+/)) {
          s = substr($0, RSTART, RLENGTH)
          sub(/^"pane_pid"[ \t]*:[ \t]*/, "", s)
          pending_pid = s; have_pid = 1
        } else {
          pending_pid = ""; have_pid = 1
        }
      }
      # A pane object closes either at its `}` or when the next pane_id starts;
      # flush when we have both fields collected for the current object.
      (have_id && have_pid) {
        emit(pending_pid, pending_id)
        have_id = 0; have_pid = 0; pending_id = ""; pending_pid = ""
      }
      END { printf "]}\n" }
    '
    exit 0
    ;;
  profiles)
    # Issue #718 / #732: the Android picker fetches host-defined agent
    # profiles with `pocketshell profiles list [--engine <e>] --json`, so a
    # real discovery journey can list + select a host profile instead of
    # false-greening on ToolUnavailable. This branch mirrors the real CLI's
    # conservative auto-discovery (profiles.py): the seeded ~/.claude default
    # dir → the "Claude" default profile (config_dir=null), and the sibling
    # ~/.zlaude dir → the non-default "Claude (Z.AI)" profile pointing at its
    # absolute config_dir. Both dirs are seeded with a real marker file in
    # the entrypoint, so they reflect genuine on-host discovery, not a canned
    # blob. Output shape matches SshProfilesGateway.parseProfiles:
    #   {"profiles":[{"name","engine","config_dir","default"}, …]}.
    shift
    if [ "${1:-}" != "list" ]; then
      printf 'pocketshell profiles fixture supports: list [--engine claude|codex] [--json]\n' >&2
      exit 64
    fi
    shift
    profiles_engine=""
    profiles_json=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --engine)
          profiles_engine="${2:-}"
          shift 2
          ;;
        --json)
          profiles_json=1
          shift
          ;;
        *)
          printf 'pocketshell profiles fixture: unknown argument: %s\n' "$1" >&2
          exit 64
          ;;
      esac
    done

    home_dir="${HOME:-/home/testuser}"

    # Build the discovered claude profile rows from the seeded dirs. A dir
    # only counts when it carries a real claude marker file, exactly like
    # profiles.py's _has_marker (conservative — no phantom profiles).
    has_claude_marker() {
      [ -d "$1" ] && { [ -f "$1/.claude.json" ] || [ -f "$1/settings.json" ]; }
    }

    # name<TAB>engine<TAB>config_dir(empty=default)<TAB>default(true/false)
    rows=""
    if has_claude_marker "${home_dir}/.claude"; then
      rows="${rows}Claude	claude		true
"
    fi
    if has_claude_marker "${home_dir}/.zlaude"; then
      rows="${rows}Claude (Z.AI)	claude	${home_dir}/.zlaude	false
"
    fi
    # codex has no seeded profile dir in this fixture, so nothing to add.

    if [ -n "$profiles_engine" ]; then
      rows="$(printf '%s' "$rows" | awk -F '\t' -v e="$profiles_engine" 'NF && $2==e')"
    else
      rows="$(printf '%s' "$rows" | awk -F '\t' 'NF')"
    fi

    if [ "$profiles_json" -eq 1 ]; then
      printf '%s\n' "$rows" | awk -F '\t' '
        function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
        BEGIN { printf "{\n  \"profiles\": [" }
        NF {
          if (n++ > 0) printf ","
          cd = ($3 == "" ? "null" : "\"" esc($3) "\"")
          printf "\n    {\"name\": \"%s\", \"engine\": \"%s\", \"config_dir\": %s, \"default\": %s}", esc($1), esc($2), cd, $4
        }
        END { if (n > 0) printf "\n  "; printf "]\n}\n" }
      '
      exit 0
    fi

    # YAML fallback (the real CLI default; the client always passes --json).
    printf 'profiles:\n'
    printf '%s\n' "$rows" | awk -F '\t' '
      NF {
        printf "  - name: %s\n", $1
        printf "    engine: %s\n", $2
        if ($3 == "") printf "    config_dir: null\n"; else printf "    config_dir: %s\n", $3
        printf "    default: %s\n", $4
      }
    '
    exit 0
    ;;
  engines)
    # Issue #2276: the availability journey must exercise the REAL host
    # registry, not a shell re-implementation of it. The bug being regressed
    # lives inside `pocketshell.engines.resolve_harnesses` (a harness that is
    # installed and launchable from the pane's LOGIN shell but invisible to
    # this NON-interactive SSH `exec` channel), so a `command -v` mimicry here
    # would prove nothing about the fix. Delegate to the repository's real
    # implementation (same idiom as the `send` arm, issue #2240) and let it
    # observe this container's genuinely off-PATH harnesses.
    #
    # Dockerfile.agents seeds ~/.config/pocketshell/engines.yaml with five
    # fixture rows (missing / disabled / nvm-only / login-only / forced) on top
    # of the built-in claude/codex/opencode/grok.
    if [ ! -d /opt/pocketshell-real/src ]; then
      printf 'pocketshell engines fixture needs /opt/pocketshell-real/src\n' >&2
      exit 64
    fi
    exec /usr/local/bin/pocketshell-real-send "$@"
    ;;
  usage)
    shift
    if [ "${1:-}" = "--json" ]; then
      cat "${fixture_dir}/pocketshell-usage.ndjson"
      exit 0
    fi
    printf 'pocketshell usage fixture supports: --json\n' >&2
    exit 64
    ;;
  sessions)
    shift
    if [ "${1:-}" = "list" ]; then
      # The app emits `pocketshell sessions list --by activity`; the
      # fixture ignores the sort flag and returns the canonical listing
      # so the trailing-timestamp parser sees a stable shape.
      cat "${fixture_dir}/pocketshell-sessions-list.txt"
      exit 0
    fi
    printf 'pocketshell sessions fixture supports: list [--by created|activity]\n' >&2
    exit 64
    ;;
  jobs)
    shift
    case "${1:-}" in
      list)
        cat "${fixture_dir}/pocketshell-jobs-list.txt"
        exit 0
        ;;
      add)
        printf 'Created job 4\n'
        exit 0
        ;;
      edit)
        printf 'Updated job %s\n' "${2:-}"
        exit 0
        ;;
      remove)
        printf 'Removed job %s\n' "${2:-}"
        exit 0
        ;;
    esac
    printf 'pocketshell jobs fixture supports: list/add/edit/remove\n' >&2
    exit 64
    ;;
  agent-log)
    shift
    engine=""
    session=""
    tail_count=""
    json_output=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --engine|-e)
          engine="${2:-}"
          shift 2
          ;;
        --session|-s)
          session="${2:-}"
          shift 2
          ;;
        --tail|-n)
          tail_count="${2:-}"
          shift 2
          ;;
        --json)
          json_output=1
          shift
          ;;
        --cwd)
          shift 2
          ;;
        *)
          printf 'unknown agent-log argument: %s\n' "$1" >&2
          exit 64
          ;;
      esac
    done
    [ -n "$engine" ] && [ -n "$session" ] || {
      printf 'pocketshell agent-log fixture requires --engine and --session\n' >&2
      exit 64
    }
    filename="${session%.jsonl}.jsonl"
    case "$engine" in
      codex)
        path="$(find "$HOME/.codex/sessions" -type f -name "$filename" -print 2>/dev/null | head -n 1)"
        ;;
      claude)
        path="$(find "$HOME/.claude/projects" -type f -name "$filename" -print 2>/dev/null | head -n 1)"
        ;;
      opencode)
        path="$HOME/.local/share/opencode/$filename"
        [ -f "$path" ] || path=""
        ;;
      *)
        printf 'unsupported fixture agent-log engine: %s\n' "$engine" >&2
        exit 64
        ;;
    esac
    [ -n "$path" ] && [ -f "$path" ] || {
      printf 'no %s session log found for %s\n' "$engine" "$session" >&2
      exit 66
    }
    if [ -n "$tail_count" ]; then
      reader="tail -n $tail_count"
    else
      reader="cat"
    fi
    if [ "$json_output" -eq 1 ]; then
      # shellcheck disable=SC2086
      $reader "$path" | awk -v engine="$engine" -v session="${session%.jsonl}" -v path="$path" "$json_escape_awk"
    else
      # shellcheck disable=SC2086
      $reader "$path"
    fi
    exit 0
    ;;
  push)
    # Issue #859 Slice A — the agent->app typed-card feed transport, made REAL
    # in the deterministic fixture so the connected emulator+Docker journey
    # exercises the SAME warm-session exec path the device hits (D21), not a
    # happy unit proxy. This mirrors the observable contract of the real Python
    # CLI (tools/pocketshell/src/pocketshell/cards.py):
    #
    #   * `pocketshell push checklist --session S [--title T] [--id ID]
    #       --item "a" --item "b" ...`  -> writes/replaces the per-session card
    #     store. Item ids are `<slug>-<index>` (slug = lowercase ascii, `-`-
    #     joined, <=48 chars; index = the 0-based position in the --item list),
    #     EXACTLY matching cards.py `_slug` + `parse_checklist_markdown`. A re-
    #     push of the same `--id` is a FULL replace (hard-cut, like cards.py
    #     `upsert_card`).
    #   * `pocketshell push get --json --session S` -> emits the app's contract
    #     `{"session":S,"cards":[{id,type,title?,created_at,updated_at,
    #       body:{items:[{id,text}]},state:{checked:[...]}}]}` — the exact JSON
    #     SessionCardsRemoteSource.parseFeed reads. (No --json => human/YAML-ish.)
    #   * `pocketshell push check --id ID --item ITEM --done|--undone
    #       --session S` -> ticks/unticks one item in `state.checked` (the app's
    #     toggle path), like cards.py `apply_interaction`. Unknown id/item -> 65.
    #   * `pocketshell push status [--json] --session S` -> the agent's read-back
    #     of the human's ticks / note read-state (cards.py `push status`).
    #   * `pocketshell push note --session S [--title T] [--id ID] --text T`
    #     -> writes/replaces a note card (`body.text`, `state.read=false`).
    #   * `pocketshell push read --id ID --read|--unread --session S` -> flips
    #     `state.read` on that note (the app's mark-as-read write-back).
    #
    # The store is per-session JSON under
    # `${POCKETSHELL_CARDS_DIR:-$HOME/.pocketshell/cards}/<session>.json`,
    # mode 0600 / dir 0700 (the cards.py private-write convention). The real CLI
    # persists YAML and emits JSON for the app; the app ONLY ever reads JSON, so
    # a JSON-backed fixture store is faithful to the app's exact contract while
    # staying parseable in POSIX `/bin/sh` (no python/yaml in this Alpine image).
    shift
    push_sub="${1:-}"
    shift 2>/dev/null || true

    push_cards_dir="${POCKETSHELL_CARDS_DIR:-$HOME/.pocketshell/cards}"
    push_now="$(date -u +%Y-%m-%dT%H:%M:%S+00:00 2>/dev/null || printf '1970-01-01T00:00:00+00:00')"

    # `tmux display-message -p '#S'` auto-detection when --session is omitted and
    # $TMUX is set, mirroring cards.py detect_session. The journey always passes
    # --session, but the agent-CLI happy path relies on auto-detect.
    push_detect_session() {
      if [ -n "${1:-}" ]; then
        printf '%s' "$1"
        return 0
      fi
      if [ -n "${TMUX:-}" ]; then
        tmux display-message -p '#S' 2>/dev/null && return 0
      fi
      return 1
    }

    # JSON-escape a string for embedding in a double-quoted JSON value.
    push_json_escape() {
      printf '%s' "$1" | awk '
        BEGIN { ORS="" }
        {
          s=$0
          gsub(/\\/, "\\\\", s)
          gsub(/"/, "\\\"", s)
          gsub(/\t/, "\\t", s)
          if (NR>1) printf "\\n"
          printf "%s", s
        }'
    }

    # Stable item id = `<slug>-<index>` (cards.py _slug + the parse index).
    push_slug() {
      printf '%s' "$1" | awk '
        {
          s=tolower($0)
          gsub(/[^a-z0-9]+/, "-", s)
          sub(/^-+/, "", s); sub(/-+$/, "", s)
          if (length(s) > 48) s=substr(s, 1, 48)
          if (s == "") s="item"
          printf "%s", s
        }'
    }

    push_session_file() {
      printf '%s/%s.json' "$push_cards_dir" "$1"
    }

    case "$push_sub" in
      checklist)
        push_title=""
        push_card_id="checklist"
        push_session_arg=""
        push_items=""   # newline-separated raw item texts
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --title) push_title="${2:-}"; shift 2 ;;
            --id) push_card_id="${2:-}"; shift 2 ;;
            --item) push_items="${push_items}${2:-}
"; shift 2 ;;
            --session) push_session_arg="${2:-}"; shift 2 ;;
            *) shift ;;
          esac
        done
        push_session="$(push_detect_session "$push_session_arg")" || {
          printf 'could not determine the tmux session: pass --session or run inside tmux.\n' >&2
          exit 64
        }
        # Build the items JSON array. The store JSON IS the app contract object.
        push_items_json=""
        push_count=0
        push_index=0
        # NOTE: iterate preserving order; a trailing empty line from the
        # accumulation is skipped.
        OLDIFS="$IFS"
        IFS='
'
        for push_raw in $push_items; do
          [ -n "$push_raw" ] || { push_index=$((push_index + 1)); continue; }
          push_text="$(printf '%s' "$push_raw" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
          [ -n "$push_text" ] || { push_index=$((push_index + 1)); continue; }
          push_slug_val="$(push_slug "$push_text")"
          push_item_id="${push_slug_val}-${push_index}"
          push_text_esc="$(push_json_escape "$push_text")"
          [ "$push_count" -gt 0 ] && push_items_json="${push_items_json},"
          push_items_json="${push_items_json}{\"id\":\"${push_item_id}\",\"text\":\"${push_text_esc}\"}"
          push_count=$((push_count + 1))
          push_index=$((push_index + 1))
        done
        IFS="$OLDIFS"
        if [ "$push_count" -eq 0 ]; then
          printf 'no checklist items: pass --item (or pipe markdown on stdin).\n' >&2
          exit 64
        fi

        # Read any existing cards for this session and drop the one we replace,
        # preserving the others (hard-cut replace of THIS card id only).
        push_file="$(push_session_file "$push_session")"
        # Compose the title key if provided.
        push_title_json=""
        if [ -n "$push_title" ]; then
          push_title_json="\"title\":\"$(push_json_escape "$push_title")\","
        fi
        push_card="{\"id\":\"$(push_json_escape "$push_card_id")\",\"type\":\"checklist\",\"created_at\":\"${push_now}\",\"updated_at\":\"${push_now}\",${push_title_json}\"body\":{\"items\":[${push_items_json}]},\"state\":{\"checked\":[]}}"

        # Preserve any OTHER existing cards (different id) verbatim. Extract them
        # from the existing store with a small python-free splitter.
        push_other_cards="$(
          if [ -f "$push_file" ]; then
            awk -v want="$push_card_id" '
              BEGIN { depth=0; incards=0; buf=""; first=1; out="" }
              {
                line=line $0 "\n"
              }
              END {
                # Parse the cards array char-by-char, emitting top-level card
                # objects whose `"id":"..."` != want.
                s=line
                n=length(s)
                # locate `"cards":[`
                idx=index(s, "\"cards\":[")
                if (idx == 0) { printf ""; exit }
                i=idx + length("\"cards\":[")
                arrdepth=1
                obj=""; objdepth=0; collecting=0
                res=""
                while (i <= n) {
                  c=substr(s, i, 1)
                  if (collecting == 0) {
                    if (c == "{") { collecting=1; objdepth=1; obj="{" }
                    else if (c == "]") { break }
                  } else {
                    obj=obj c
                    if (c == "{") objdepth++
                    else if (c == "}") {
                      objdepth--
                      if (objdepth == 0) {
                        # got one card object in obj
                        idpos=match(obj, /"id"[ ]*:[ ]*"[^"]*"/)
                        cid=""
                        if (idpos > 0) {
                          frag=substr(obj, idpos, RLENGTH)
                          sub(/"id"[ ]*:[ ]*"/, "", frag)
                          sub(/".*/, "", frag)
                          cid=frag
                        }
                        if (cid != want) {
                          if (res != "") res=res ","
                          res=res obj
                        }
                        collecting=0; obj=""
                      }
                    }
                  }
                  i++
                }
                printf "%s", res
              }
            ' "$push_file"
          fi
        )"

        push_all_cards="$push_card"
        if [ -n "$push_other_cards" ]; then
          push_all_cards="${push_other_cards},${push_card}"
        fi

        mkdir -p "$push_cards_dir" 2>/dev/null || true
        chmod 700 "$push_cards_dir" 2>/dev/null || true
        push_tmp="${push_file}.tmp.$$"
        printf '{"session":"%s","cards":[%s]}\n' "$(push_json_escape "$push_session")" "$push_all_cards" > "$push_tmp"
        chmod 600 "$push_tmp" 2>/dev/null || true
        mv -f "$push_tmp" "$push_file"
        printf "checklist '%s' (%d items) -> session '%s' (%s)\n" "$push_card_id" "$push_count" "$push_session" "$push_file"
        exit 0
        ;;
      get)
        push_as_json=0
        push_session_arg=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --json) push_as_json=1; shift ;;
            --session) push_session_arg="${2:-}"; shift 2 ;;
            *) shift ;;
          esac
        done
        push_session="$(push_detect_session "$push_session_arg")" || {
          printf 'could not determine the tmux session: pass --session or run inside tmux.\n' >&2
          exit 64
        }
        push_file="$(push_session_file "$push_session")"
        if [ "$push_as_json" -eq 1 ]; then
          if [ -f "$push_file" ]; then
            cat "$push_file"
          else
            printf '{"session":"%s","cards":[]}\n' "$(push_json_escape "$push_session")"
          fi
          exit 0
        fi
        if [ -f "$push_file" ]; then
          cat "$push_file"
        else
          printf '(no cards for session %s)\n' "$push_session"
        fi
        exit 0
        ;;
      status)
        push_as_json=0
        push_session_arg=""
        push_only_id=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --json) push_as_json=1; shift ;;
            --id) push_only_id="${2:-}"; shift 2 ;;
            --session) push_session_arg="${2:-}"; shift 2 ;;
            *) shift ;;
          esac
        done
        push_session="$(push_detect_session "$push_session_arg")" || {
          printf 'could not determine the tmux session: pass --session or run inside tmux.\n' >&2
          exit 64
        }
