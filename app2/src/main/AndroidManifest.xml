<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Task U-2: the app dials SSH. Without this the socket in
        `RealHostConnectionFactory` fails with EACCES on every device and every
        connect surfaces as an opaque `ConnectResult.Failed` — a failure no
        host-JVM test can see, because Robolectric does not enforce Android
        permissions. It is declared here, with the first code that opens a
        socket, rather than preemptively in the M-1 scaffold.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketShellNext">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PocketShellNext"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
