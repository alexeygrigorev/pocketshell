        push_new="$(
          awk -v want="$push_card_id" -v readflag="$push_read" -v now="$push_now" '
            BEGIN { found_card=0; found_note=0 }
            { line=line $0 "\n" }
            END {
              s=line; n=length(s)
              idx=index(s, "\"cards\":[")
              if (idx == 0) { printf "%s", s; exit }
              prefix=substr(s, 1, idx + length("\"cards\":[") - 1)
              i=idx + length("\"cards\":[")
              collecting=0; obj=""; objdepth=0; cards=""; suffix=""
              while (i <= n) {
                c=substr(s, i, 1)
                if (collecting == 0) {
                  if (c == "{") { collecting=1; objdepth=1; obj="{" }
                  else if (c == "]") { suffix=substr(s, i); break }
                } else {
                  obj=obj c
                  if (c == "{") objdepth++
                  else if (c == "}") {
                    objdepth--
                    if (objdepth == 0) {
                      cid=""; ctype=""
                      if (match(obj, /"id"[ ]*:[ ]*"[^"]*"/)) {
                        f=substr(obj, RSTART, RLENGTH); sub(/"id"[ ]*:[ ]*"/, "", f); sub(/".*/, "", f); cid=f
                      }
                      if (match(obj, /"type"[ ]*:[ ]*"[^"]*"/)) {
                        f=substr(obj, RSTART, RLENGTH); sub(/"type"[ ]*:[ ]*"/, "", f); sub(/".*/, "", f); ctype=f
                      }
                      if (cid == want) {
                        found_card=1
                        if (ctype == "note") {
                          found_note=1
                          sp=index(obj, "\"state\":")
                          head=substr(obj, 1, sp - 1)
                          if (readflag == "1") {
                            obj=head "\"state\":{\"read\":true,\"read_at\":\"" now "\"}}"
                          } else {
                            obj=head "\"state\":{\"read\":false,\"read_at\":null}}"
                          }
                        }
                      }
                      if (cards != "") cards=cards ","
                      cards=cards obj
                      collecting=0; obj=""
                    }
                  }
                }
                i++
              }
              if (found_card == 0) { printf "__NO_CARD__"; exit }
              if (found_note == 0) { printf "__NOT_NOTE__"; exit }
              printf "%s%s%s", prefix, cards, suffix
            }
          ' "$push_file"
        )"
        case "$push_new" in
          __NO_CARD__)
            printf "no card with id '%s' in session '%s'\n" "$push_card_id" "$push_session" >&2
            exit 65 ;;
          __NOT_NOTE__)
            printf "card '%s' is not a note\n" "$push_card_id" >&2
            exit 65 ;;
        esac
        push_tmp="${push_file}.tmp.$$"
        printf '%s' "$push_new" > "$push_tmp"
        chmod 600 "$push_tmp" 2>/dev/null || true
        mv -f "$push_tmp" "$push_file"
        if [ "$push_read" -eq 1 ]; then
          printf "%s: note: read\n" "$push_card_id"
        else
          printf "%s: note: unread\n" "$push_card_id"
        fi
        exit 0
        ;;
      *)
        printf 'pocketshell push fixture supports: checklist|get|status|check|note|read\n' >&2
        exit 64
        ;;
    esac
    ;;
  tree)
    # The standard `agents` fixture intentionally does not fake the durable
    # file-workspace RPC. Issue #1715 journeys must target `agents-daemon`
    # (port 2239), whose real Python tree registry owns the schema and the
    # atomic persistence contract. Keeping a workspace.json side store here
    # would let a proof pass without exercising the product host protocol.
    shift
    case "${1:-}" in
      workspace-get|workspace-upsert)
        printf 'pocketshell fixture: workspace RPC requires agents-daemon (port 2239)\n' >&2
        exit 64
        ;;
      get|upsert|reconcile)
        if [ "${POCKETSHELL_FIXTURE_REAL_TREE:-0}" = "1" ]; then
          exec /usr/local/bin/pocketshell-real tree "$@"
        fi
        # Tree durability lives on the agents-daemon fixture. A no-op empty
        # envelope keeps a stray `tree get` on this image from hanging.
        printf '{"nodes":[],"version":0,"alive":[],"gone":[],"added":[]}\n'
        exit 0
        ;;
      *)
        printf 'pocketshell tree fixture supports: get|upsert|reconcile\n' >&2
        exit 64
        ;;
    esac
    ;;
esac

printf 'pocketshell fixture supports: usage --json, sessions list/create/attach/kill, agent-log, profiles list, engines list --json, agents kind, tree get|upsert|reconcile\n' >&2
exit 64
