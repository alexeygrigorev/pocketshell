#!/bin/sh
set -eu

# Run the REAL `pocketshell` CLI inside the deterministic agents image: the
# pinned PyPI wheel installed at build time (issue #2643 — the CLI is no
# longer built from this repo, so there is no source tree to PYTHONPATH into).
# The `pocketshell` command beside this helper remains the fixture shim for
# non-session probes; this helper is the single real host-CLI entrypoint used
# for aplexer lifecycle, tree, engine, and session-seeding operations.
exec python3 -m pocketshell "$@"
