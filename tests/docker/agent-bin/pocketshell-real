#!/bin/sh
set -eu

# Run the repository's real Python `pocketshell` package inside the deterministic
# agents image. The `pocketshell` command beside this helper remains the fixture
# shim for non-session probes; this helper is the single real host-CLI entrypoint
# used for aplexer lifecycle, tree, engine, and session-seeding operations.
real_src=/opt/pocketshell-real/src
if [ -n "${PYTHONPATH:-}" ]; then
  export PYTHONPATH="$real_src:$PYTHONPATH"
else
  export PYTHONPATH="$real_src"
fi
exec python3 -m pocketshell "$@"
