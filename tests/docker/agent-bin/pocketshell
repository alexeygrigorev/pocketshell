#!/bin/sh
set -eu

# Deterministic fixture for the unified `pocketshell` CLI.
#
# Issue #231 moved the Android app to the unified `pocketshell` CLI (D22
# hard-cut). The fixture keeps deterministic payloads for the non-session
# probes and delegates session lifecycle commands to the repository's real
# aplexer-only implementation:
#   - `pocketshell usage --json`            -> PocketshellUsageJsonParser
#   - `pocketshell sessions list [--json]`  -> schema-3 session parser
#   - `pocketshell agent-log --json ...`    -> AgentConversationRepository

fixture_dir="${POCKETSHELL_AGENT_FIXTURE_DIR:-/opt/pocketshell-agent-fixtures}"
version_file="${POCKETSHELL_AGENT_FIXTURE_VERSION_FILE:-/opt/pocketshell-agent-fixture-version}"

fixture_version() {
  if [ -n "${POCKETSHELL_AGENT_FIXTURE_VERSION:-}" ]; then
    printf '%s\n' "$POCKETSHELL_AGENT_FIXTURE_VERSION"
    return 0
  fi
  if [ -r "$version_file" ]; then
    cat "$version_file"
    return 0
  fi
  # Issue #2356 (Phase 4 of epic #2350): app/build.gradle.kts's versionName
  # is no longer a literal to sed out of the DSL text -- it is derived from
  # the git tag via scripts/derive-version.sh (the same script
  # app/build.gradle.kts itself shells out to). Delegate to it instead of a
  # second, independently-written derivation.
  derive_script="${POCKETSHELL_PROJECT_ROOT:-.}/scripts/derive-version.sh"
  if [ -r "$derive_script" ]; then
    parsed_version="$(bash "$derive_script" version-name 2>/dev/null || true)"
    if [ -n "$parsed_version" ]; then
      printf '%s\n' "$parsed_version"
      return 0
    fi
  fi
  printf '0.0.0\n'
}

json_escape_awk='
function esc(s) {
  gsub(/\\/, "\\\\", s)
  gsub(/"/, "\\\"", s)
  return s
}
{
  lines[++count] = $0
}
END {
  printf "{\"count\":%d,\"engine\":\"%s\",\"lines\":[", count, engine
  for (i = 1; i <= count; i++) {
    if (i > 1) printf ","
    printf "\"%s\"", esc(lines[i])
  }
  printf "],\"path\":\"%s\",\"session\":\"%s\"}\n", esc(path), esc(session)
}
'

case "${1:-}" in
  --version)
    printf 'pocketshell fixture %s\n' "$(fixture_version)"
    exit 0
    ;;
  agent)
    # Issue #703: the app now launches agents via the short server-side
    # wrapper `pocketshell agent <kind> --dir <dir> [--no-skip-permissions]
    # [--config-dir <dir>]` instead of a giant inline env-strip line. This
    # fixture mirrors the real wrapper's observable behaviour: parse the
    # short argv, cd into --dir, then exec the (fake) agent so the
    # AgentLaunchCommandDockerTest sees the agent's ready output land in the
    # pane — proving the wrapper exec'd the agent, not just that text was
    # typed. The real wrapper additionally merges .env/.envrc, strips the
    # provider env for opencode, and suppresses first-run prompts; the fake
    # agents have no such prompts so nothing extra is needed here.
    shift
    agent_kind="${1:-}"
    shift || true
    agent_dir=""
    agent_profile=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --dir)
          agent_dir="${2:-}"
          shift 2
          ;;
        --skip-permissions|--no-skip-permissions)
          shift
          ;;
        --config-dir)
          shift 2
          ;;
        --profile)
          agent_profile="${2:-}"
          shift 2
          ;;
        *)
          shift
          ;;
      esac
    done
    if [ -n "$agent_dir" ]; then
      cd "$agent_dir" 2>/dev/null || true
    fi
    # Issue #821 / #858 / #889: mirror the REAL wrapper's record_agent_kind
    # (tools/pocketshell/src/pocketshell/agents.py) so an end-to-end Docker
    case "$agent_kind" in
      codex|claude|opencode)
        exec "$agent_kind"
        ;;
      *)
        printf 'pocketshell agent fixture supports: codex|claude|opencode\n' >&2
        exit 64
        ;;
    esac
    ;;
  agents)
    # Epic #821 A2-infra (issue #827): the unified CLI grew `pocketshell
    # agents kind`, the seam over the `agents.kind_for_panes` daemon RPC. The
    # client pipes a pane list as `{"panes":[{"pane_id","pane_pid"}, ...]}` JSON
    # on stdin (and/or `--pane PANE_ID=PANE_PID`) and parses back
    # `{"results":[{"pane_id","agent_kind","scope","evidence_pid"?}]}`.
    #
    # This Docker container has no real cgroup-v2 scope tree, so the fixture
    # can't run the live classifier. Instead it answers DETERMINISTICALLY for
    # SYNTHETIC (non-existent) pane pids, so a connected test can assert a
    # foreign session's guessed kind without seeding a cgroup tree:
    #   pid 1000-1999 -> claude (scope fixture-claude-main.scope)
    #   pid 2000-2999 -> codex  (scope fixture-codex.scope)
    #   pid 3000-3999 -> opencode (scope fixture-opencode-lab.scope)
    #   pid 4000-4999 -> none   (scope fixture-shell.scope; readable, no agent)
    #   missing / non-integer / any other pid -> unknown (scope null)
    # These ranges line up with the seeded fixture sessions claude-main / codex
    # / opencode-lab so the guess matches the synthetic session the test joins.
    #
    # Issue #1973: a REAL live session pid must never enter this synthetic
    # table. The nightly suite advances the container PID allocator through
    # these ranges; the old fixture then called an ordinary `sh` pane Claude /
    # Codex / OpenCode solely from its numeric pid. That contaminated later
    # state-readback and folder-list tests even though raw @ps_agent_kind was
    # absent, the previous agent sessions were gone, and /proc showed the pane
    # was a live shell in the container's root cgroup. A real pid is therefore
    # owned by the live fixture, not by the synthetic canned table: resolve it
    # to `none`. PocketShell-launched fixture agents remain covered by their
    # authoritative recorded @ps_agent_kind and never take this foreign path.
    #
    # Issue #975: one connected regression deliberately models the narrower
    # real-host failure where a LIVE pane is unreadable to the classifier while
    # its transcript is still trustworthy evidence. The seeder opts that exact
    # pid into `unknown` by creating
    # `/tmp/pocketshell-agents-kind-unknown-pids/<pid>`.  This is explicit
    # per-pane state, never pid-range inference, so the #1973 live-shell rule
    # remains authoritative for every unmarked live process.
    shift
    if [ "${1:-}" != "kind" ]; then
      printf 'pocketshell agents fixture supports: kind\n' >&2
      exit 64
    fi
    shift

    # Issue #1641: connected latency-fixture hook for the storm-entry-edge
    # journey. A foreign-pane kind-classify runs over the SHARED per-host `-CC`
    # lease transport under a fixed 3.5s bound (AgentKindRemoteSource /
    # BoundedSessionExec). Before the fix, a classify SLOWER than that bound
    # `close()`d the shared transport — killing the live `-CC` reader and
    # entering the #1610 reconnect storm. A localhost-fast classify can never
    # exceed 3.5s, so it proves NOTHING about that edge (the v0.4.10/#847
    # happy-fixture-masks-reality lesson, G10). This hook makes ONLY `agents
    # kind` genuinely slow — an alive-but-slow host CLI, exactly the reported
    # non-happy state — for the duration a connected test needs it.
    #
    # A test writes an integer number of seconds into the delay file over the
    # SAME warm SSH session; the classify then sleeps that long BEFORE it
    # answers (still returning a valid envelope, so the host is proven ALIVE,
    # not failing). No file / empty / non-integer => zero delay, so every other
    # `agents kind` consumer (the deterministic guess fixtures) is unaffected.
    delay_file="${POCKETSHELL_AGENTS_KIND_DELAY_FILE:-/tmp/pocketshell-agents-kind-delay-secs}"
    if [ -r "$delay_file" ]; then
      delay_secs="$(cat "$delay_file" 2>/dev/null || printf '')"
      case "$delay_secs" in
        '' | *[!0-9]*) : ;;
        *) sleep "$delay_secs" ;;
      esac
    fi

    # Collect panes from --pane PANE_ID=PANE_PID options.
    pane_specs=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --pane)
          pane_specs="${pane_specs}${2:-}
"
          shift 2
          ;;
        --proc-root|--cgroup-mount)
          shift 2
          ;;
        *)
          shift
          ;;
      esac
    done

    # Read stdin JSON panes when stdin is not a terminal. Extract pane_id /
    # pane_pid pairs without a JSON parser (busybox has no jq): pull every
    # "pane_id":... and "pane_pid":... token in document order. pane_pid is
    # numeric in the RPC shape; a missing pid yields an empty field -> unknown.
    if [ ! -t 0 ]; then
      stdin_json="$(cat)"
    else
      stdin_json=""
    fi

    printf '%s' "$stdin_json" | tr ',' '\n' | awk -v specs="$pane_specs" '
      function classify(pid,   n) {
        if (pid !~ /^[0-9]+$/) return "unknown\tnull"
        n = pid + 0
        if (system("test -f /tmp/pocketshell-agents-kind-unknown-pids/" n) == 0) return "unknown\tnull"
        if (system("test -d /proc/" n) == 0) return "none\tpocketshell-fixture-live.scope"
        if (n >= 1000 && n < 2000) return "claude\tfixture-claude-main.scope"
        if (n >= 2000 && n < 3000) return "codex\tfixture-codex.scope"
        if (n >= 3000 && n < 4000) return "opencode\tfixture-opencode-lab.scope"
        if (n >= 4000 && n < 5000) return "none\tfixture-shell.scope"
        return "unknown\tnull"
      }
      function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
      function emit(pid, pane_id,   c, kind, scope, parts) {
        c = classify(pid)
        split(c, parts, "\t")
        kind = parts[1]; scope = parts[2]
        if (n++ > 0) printf ","
        if (scope == "null") sval = "null"; else sval = "\"" esc(scope) "\""
        printf "{\"pane_id\":\"%s\",\"agent_kind\":\"%s\",\"scope\":%s}", esc(pane_id), kind, sval
      }
      BEGIN {
        printf "{\"results\":["
        # --pane PANE_ID=PANE_PID specs first.
        m = split(specs, lines, "\n")
        for (i = 1; i <= m; i++) {
          if (lines[i] == "") continue
          eq = index(lines[i], "=")
          if (eq == 0) continue
          pid_id = substr(lines[i], 1, eq - 1)
          pid_pid = substr(lines[i], eq + 1)
          emit(pid_pid, pid_id)
        }
      }
      # stdin JSON tokens, one comma-split fragment per line.
      /"pane_id"/ {
        if (match($0, /"pane_id"[ \t]*:[ \t]*"[^"]*"/)) {
          s = substr($0, RSTART, RLENGTH)
          sub(/^"pane_id"[ \t]*:[ \t]*"/, "", s); sub(/"$/, "", s)
          pending_id = s; have_id = 1
        }
      }
      /"pane_pid"/ {
        if (match($0, /"pane_pid"[ \t]*:[ \t]*[0-9]+/)) {
          s = substr($0, RSTART, RLENGTH)
          sub(/^"pane_pid"[ \t]*:[ \t]*/, "", s)
          pending_pid = s; have_pid = 1
        } else {
          pending_pid = ""; have_pid = 1
        }
      }
      # A pane object closes either at its `}` or when the next pane_id starts;
      # flush when we have both fields collected for the current object.
      (have_id && have_pid) {
        emit(pending_pid, pending_id)
        have_id = 0; have_pid = 0; pending_id = ""; pending_pid = ""
      }
      END { printf "]}\n" }
    '
    exit 0
    ;;
  profiles)
    # Issue #718 / #732: the Android picker fetches host-defined agent
    # profiles with `pocketshell profiles list [--engine <e>] --json`, so a
    # real discovery journey can list + select a host profile instead of
    # false-greening on ToolUnavailable. This branch mirrors the real CLI's
    # conservative auto-discovery (profiles.py): the seeded ~/.claude default
    # dir → the "Claude" default profile (config_dir=null), and the sibling
    # ~/.zlaude dir → the non-default "Claude (Z.AI)" profile pointing at its
    # absolute config_dir. Both dirs are seeded with a real marker file in
    # the entrypoint, so they reflect genuine on-host discovery, not a canned
    # blob. Output shape matches SshProfilesGateway.parseProfiles:
    #   {"profiles":[{"name","engine","config_dir","default"}, …]}.
    shift
    if [ "${1:-}" != "list" ]; then
      printf 'pocketshell profiles fixture supports: list [--engine claude|codex] [--json]\n' >&2
      exit 64
    fi
    shift
    profiles_engine=""
    profiles_json=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --engine)
          profiles_engine="${2:-}"
          shift 2
          ;;
        --json)
          profiles_json=1
          shift
          ;;
        *)
          printf 'pocketshell profiles fixture: unknown argument: %s\n' "$1" >&2
          exit 64
          ;;
      esac
    done

    home_dir="${HOME:-/home/testuser}"

    # Build the discovered claude profile rows from the seeded dirs. A dir
    # only counts when it carries a real claude marker file, exactly like
    # profiles.py's _has_marker (conservative — no phantom profiles).
    has_claude_marker() {
      [ -d "$1" ] && { [ -f "$1/.claude.json" ] || [ -f "$1/settings.json" ]; }
    }

    # name<TAB>engine<TAB>config_dir(empty=default)<TAB>default(true/false)
    rows=""
    if has_claude_marker "${home_dir}/.claude"; then
      rows="${rows}Claude	claude		true
"
    fi
    if has_claude_marker "${home_dir}/.zlaude"; then
      rows="${rows}Claude (Z.AI)	claude	${home_dir}/.zlaude	false
"
    fi
    # codex has no seeded profile dir in this fixture, so nothing to add.

    if [ -n "$profiles_engine" ]; then
      rows="$(printf '%s' "$rows" | awk -F '\t' -v e="$profiles_engine" 'NF && $2==e')"
    else
      rows="$(printf '%s' "$rows" | awk -F '\t' 'NF')"
    fi

    if [ "$profiles_json" -eq 1 ]; then
      printf '%s\n' "$rows" | awk -F '\t' '
        function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
        BEGIN { printf "{\n  \"profiles\": [" }
        NF {
          if (n++ > 0) printf ","
          cd = ($3 == "" ? "null" : "\"" esc($3) "\"")
          printf "\n    {\"name\": \"%s\", \"engine\": \"%s\", \"config_dir\": %s, \"default\": %s}", esc($1), esc($2), cd, $4
        }
        END { if (n > 0) printf "\n  "; printf "]\n}\n" }
      '
      exit 0
    fi

    # YAML fallback (the real CLI default; the client always passes --json).
    printf 'profiles:\n'
    printf '%s\n' "$rows" | awk -F '\t' '
      NF {
        printf "  - name: %s\n", $1
        printf "    engine: %s\n", $2
        if ($3 == "") printf "    config_dir: null\n"; else printf "    config_dir: %s\n", $3
        printf "    default: %s\n", $4
      }
    '
    exit 0
    ;;
  engines)
    # Issue #2276: the availability journey must exercise the REAL host
    # registry, not a shell re-implementation of it. The bug being regressed
    # lives inside `pocketshell.engines.resolve_harnesses` (a harness that is
    # installed and launchable from the pane's LOGIN shell but invisible to
    # this NON-interactive SSH `exec` channel), so a `command -v` mimicry here
    # would prove nothing about the fix. Delegate to the repository's real
    # implementation (same idiom as the `send` arm, issue #2240) and let it
    # observe this container's genuinely off-PATH harnesses.
    #
    # Dockerfile.agents seeds ~/.config/pocketshell/engines.yaml with five
    # fixture rows (missing / disabled / nvm-only / login-only / forced) on top
    # of the built-in claude/codex/opencode/grok.
    if [ ! -d /opt/pocketshell-real/src ]; then
      printf 'pocketshell engines fixture needs /opt/pocketshell-real/src\n' >&2
      exit 64
    fi
    exec /usr/local/bin/pocketshell-real "$@"
    ;;
  usage)
    shift
    if [ "${1:-}" = "--json" ]; then
      cat "${fixture_dir}/pocketshell-usage.ndjson"
      exit 0
    fi
    printf 'pocketshell usage fixture supports: --json\n' >&2
    exit 64
    ;;
  workspaces)
    shift
    workspace_operation="${1:-}"
    [ "$#" -gt 0 ] && shift
    workspace_host=""
    workspace_path=""
    workspace_json=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --host)
          [ "$#" -ge 2 ] || {
            printf 'pocketshell workspaces: --host needs a value\n' >&2
            exit 64
          }
          workspace_host="$2"
          shift 2
          ;;
        --host=*)
          workspace_host="${1#--host=}"
          shift
          ;;
        --json)
          workspace_json=1
          shift
          ;;
        --)
          shift
          [ "$#" -gt 0 ] || {
            printf 'pocketshell workspaces: path is required\n' >&2
            exit 64
          }
          [ -z "$workspace_path" ] || {
            printf 'pocketshell workspaces: unexpected extra path\n' >&2
            exit 64
          }
          workspace_path="$1"
          shift
          ;;
        -*)
          printf 'pocketshell workspaces: unknown argument: %s\n' "$1" >&2
          exit 64
          ;;
        *)
          [ -z "$workspace_path" ] || {
            printf 'pocketshell workspaces: unexpected extra path\n' >&2
            exit 64
          }
          workspace_path="$1"
          shift
          ;;
      esac
    done
    [ -n "$workspace_host" ] || {
      printf 'pocketshell workspaces: --host is required\n' >&2
      exit 64
    }
    case "$workspace_operation" in
      list)
        [ -z "$workspace_path" ] || {
          printf 'pocketshell workspaces list: unexpected path\n' >&2
          exit 64
        }
        ;;
      add|remove)
        [ -n "$workspace_path" ] || {
          printf 'pocketshell workspaces %s: path is required\n' "$workspace_operation" >&2
          exit 64
        }
        ;;
      *)
        printf 'pocketshell workspaces fixture supports: list/add/remove\n' >&2
        exit 64
        ;;
    esac
    workspace_state_file="${POCKETSHELL_WORKSPACES_STATE_FILE:-${HOME}/.pocketshell-workspaces.json}"
    # Keep this fixture's state contract equivalent to the real host CLI. The
    # app only needs an empty listing for J01, but add/remove are implemented
    # here as well so the connected workspace flow can exercise durable
    # membership instead of a canned response.
    python3 - "$workspace_operation" "$workspace_host" "$workspace_path" "$workspace_state_file" <<'PYEOF'
import json
import os
import sys
from pathlib import Path


operation, host, raw_path, state_name = sys.argv[1:]
state_path = Path(state_name).expanduser()


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(64)


def canonical_path(raw: str) -> str:
    if not raw or not raw.strip():
        fail("pocketshell workspaces: `path` must be a non-empty path")
    expanded = os.path.expanduser(raw.strip())
    if not os.path.isabs(expanded):
        fail("pocketshell workspaces: `path` must be absolute or use the `~/` form")
    return str(Path(expanded).resolve(strict=False))


def read_state() -> dict:
    try:
        with state_path.open(encoding="utf-8") as handle:
            value = json.load(handle)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {"workspaces": {}}
    return value if isinstance(value, dict) else {"workspaces": {}}


def entries(state: dict) -> list[dict[str, str]]:
    all_workspaces = state.get("workspaces")
    raw_entries = all_workspaces.get(host) if isinstance(all_workspaces, dict) else []
    if not isinstance(raw_entries, list):
        return []
    by_path: dict[str, dict[str, str]] = {}
    for value in raw_entries:
        if not isinstance(value, dict):
            continue
        try:
            path = canonical_path(str(value.get("path", "")))
        except SystemExit:
            continue
        display = value.get("display_path")
        by_path.setdefault(
            path,
            {
                "path": path,
                "display_path": display.strip() if isinstance(display, str) and display.strip() else path,
            },
        )
    return [by_path[path] for path in sorted(by_path)]


def write_state(state: dict) -> None:
    state_path.parent.mkdir(parents=True, exist_ok=True)
    temporary = state_path.with_name(state_path.name + ".tmp")
    with temporary.open("w", encoding="utf-8") as handle:
        json.dump(state, handle, sort_keys=True)
        handle.write("\n")
    temporary.replace(state_path)


state = read_state()
items = entries(state)
created = None
removed = None
canonical = None
if operation == "add":
    canonical = canonical_path(raw_path)
    existing = next((item for item in items if item["path"] == canonical), None)
    if existing is None:
        existing = {"path": canonical, "display_path": raw_path.strip()}
        items.append(existing)
        items.sort(key=lambda item: item["path"])
        created = True
        state.setdefault("workspaces", {})[host] = items
        write_state(state)
    else:
        created = False
elif operation == "remove":
    canonical = canonical_path(raw_path)
    kept = [item for item in items if item["path"] != canonical]
    removed = len(kept) != len(items)
    if removed:
        items = kept
        state.setdefault("workspaces", {})[host] = items
        write_state(state)

result = {"schema": 1, "host": host, "workspaces": items}
if created is not None:
    result["created"] = created
    result["workspace"] = next(item for item in items if item["path"] == canonical)
if removed is not None:
    result["path"] = canonical
    result["removed"] = removed
print(json.dumps(result, sort_keys=True))
PYEOF
    exit 0
    ;;
  sessions)
    shift
    # The Docker fixture has no delegated systemd --user scope, so the real
    # CLI's host default memory cap cannot be enforced here. Android creates a
    # plain session without a memory option; supply the fixture-only explicit
    # uncapped choice before delegating to the REAL CLI. Calls that choose a
    # cap explicitly keep their original arguments and therefore still test
    # the production memory-policy path.
    if [ "${1:-}" = "create" ]; then
      shift
      has_mem=0
      for session_arg in "$@"; do
        case "$session_arg" in
          --mem|--mem=*) has_mem=1; break ;;
        esac
      done
      if [ "$has_mem" -eq 0 ]; then
        set -- create --mem none "$@"
      else
        set -- create "$@"
      fi
    fi
    # Session lifecycle is the product contract. Run the real package against
    # the real bundled aplexer; this fixture must not maintain a second session
    # protocol or silently turn an unavailable aplexer into canned rows.
    if [ ! -d /opt/pocketshell-real/src ]; then
      printf 'pocketshell sessions fixture needs /opt/pocketshell-real/src\n' >&2
      exit 64
    fi
    if [ "${1:-}" = "list" ] && [ -r "${POCKETSHELL_FIXTURE_SESSION_ERRORS_FILE:-$HOME/.pocketshell-fixture-session-errors.json}" ]; then
      errors_file="${POCKETSHELL_FIXTURE_SESSION_ERRORS_FILE:-$HOME/.pocketshell-fixture-session-errors.json}"
      list_output="$(mktemp)"
      list_error="$(mktemp)"
      if /usr/local/bin/pocketshell-real sessions "$@" >"$list_output" 2>"$list_error"; then
        case " $* " in
          *" --json "*)
            ERRORS_FILE="$errors_file" python3 - "$list_output" <<'PYEOF'
import json, os, sys
from pathlib import Path

payload = json.loads(Path(sys.argv[1]).read_text())
payload["errors"] = json.loads(Path(os.environ["ERRORS_FILE"]).read_text())
print(json.dumps(payload, indent=2))
PYEOF
            rm -f "$list_output" "$list_error"
            exit 0
            ;;
        esac
        cat "$list_output"
        rm -f "$list_output" "$list_error"
        exit 0
      else
        status=$?
      fi
      cat "$list_output"
      cat "$list_error" >&2
      rm -f "$list_output" "$list_error"
      exit "$status"
    fi
    exec /usr/local/bin/pocketshell-real sessions "$@"

    ;;
  agent-log)
    shift
    engine=""
    session=""
    tail_count=""
    json_output=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --engine|-e)
          engine="${2:-}"
          shift 2
          ;;
        --session|-s)
          session="${2:-}"
          shift 2
          ;;
        --tail|-n)
          tail_count="${2:-}"
          shift 2
          ;;
        --json)
          json_output=1
          shift
          ;;
        --cwd)
          shift 2
          ;;
        *)
          printf 'unknown agent-log argument: %s\n' "$1" >&2
          exit 64
          ;;
