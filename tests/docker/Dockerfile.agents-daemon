# Real host-CLI fixture for the durable project-tree journey (#839).
#
# It shares the standard agents image's real aplexer binaries and entrypoint,
# then enables the real Python tree registry. The session lifecycle and the
# tree reconcile probe therefore run through the same product code used by a
# normal install.
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server openssh-client procps bash sqlite3 git nano \
        ca-certificates curl python3 python3-pip python3-yaml \
    && find /var/lib/apt/lists -mindepth 1 -delete \
    && ln -sfn /usr/lib/openssh /usr/lib/ssh \
    && mkdir -p /run/sshd \
    && ssh-keygen -A \
    && useradd -m -s /bin/sh testuser \
    && usermod -p '*' testuser \
    && mkdir -p /home/testuser/.ssh \
    && chmod 700 /home/testuser/.ssh

COPY tests/docker/fixture-pins.txt /opt/pocketshell-fixture/pins.txt
# Issue #2643: the real CLI is the pinned PyPI wheel, installed before the
# agent-bin COPY so the fixture shims overwrite the wheel's console scripts.
RUN set -eu; \
    cli_pin="$(sed -n 's/^POCKETSHELL_PIN=\([0-9][^"; ]*\).*/\1/p' /opt/pocketshell-fixture/pins.txt | head -1)"; \
    test -n "$cli_pin"; \
    ver="$(sed -n 's/^APLEXER_PIN=\([0-9][^"; ]*\).*/\1/p' /opt/pocketshell-fixture/pins.txt | head -1)"; \
    test -n "$ver"; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) asset_arch=linux-amd64 ;; arm64) asset_arch=linux-arm64 ;; *) exit 1 ;; esac; \
    base="https://github.com/alexeygrigorev/aplexer/releases/download/v${ver}"; \
    curl -fsSL -o /usr/bin/a "$base/a-${asset_arch}"; \
    curl -fsSL -o /usr/bin/aplexer "$base/aplexer-${asset_arch}"; \
    chmod +x /usr/bin/a /usr/bin/aplexer; \
    pip install --break-system-packages --no-cache-dir "pocketshell==${cli_pin}"

COPY tests/docker/sshd_config /etc/ssh/sshd_config
COPY tests/docker/test_key.pub /home/testuser/.ssh/authorized_keys
COPY tests/docker/test_key /root/test_key
COPY tests/docker/agent-bin/ /usr/local/bin/
COPY tests/docker/agent-fixtures/ /opt/pocketshell-agent-fixtures/
COPY tests/docker/agent-entrypoint.sh /usr/local/bin/pocketshell-agent-entrypoint
COPY tests/docker/agents-aplexer-selfcheck.py /usr/local/bin/pocketshell-fixture-aplexer-selfcheck

ENV POCKETSHELL_FIXTURE_REAL_TREE=1

RUN chmod 600 /home/testuser/.ssh/authorized_keys /root/test_key \
    && chmod +x /usr/local/bin/claude /usr/local/bin/codex \
        /usr/local/bin/opencode /usr/local/bin/pocketshell \
        /usr/local/bin/quse /usr/local/bin/agent-log-explorer \
        /usr/local/bin/uv \
        /usr/local/bin/pocketshell-tui-smoke \
        /usr/local/bin/pocketshell-altscreen-tui \
        /usr/local/bin/pocketshell-fake-agent \
        /usr/local/bin/pocketshell-agent-entrypoint \
        /usr/local/bin/pocketshell-fixture-aplexer-selfcheck \
        /usr/local/bin/pocketshell-real \
    && chown -R testuser:testuser /home/testuser/.ssh

EXPOSE 22

CMD ["/usr/local/bin/pocketshell-agent-entrypoint"]
